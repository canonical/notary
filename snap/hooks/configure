#!/bin/sh -e

# Renders $SNAP_COMMON/notary.yaml from snap options so a machine charm (or an
# operator) can configure a cluster member without editing files in place.
#
# Until an option is set this hook does nothing, so an existing hand-edited
# config keeps working after a refresh.

CONFIG="$SNAP_COMMON/notary.yaml"

get() {
	snapctl get "$1" 2>/dev/null || true
}

cluster_name="$(get cluster.name)"
cluster_address="$(get cluster.address)"
join_token="$(get cluster.join-token)"
port="$(get port)"
external_hostname="$(get external-hostname)"
log_level="$(get log-level)"
encryption_backend="$(get encryption-backend)"

if [ -z "$cluster_name$cluster_address$join_token$port$external_hostname$log_level$encryption_backend" ]; then
	exit 0
fi

[ -n "$cluster_address" ] || cluster_address="127.0.0.1:9000"
[ -n "$port" ] || port="3000"
[ -n "$log_level" ] || log_level="info"
[ -n "$encryption_backend" ] || encryption_backend="none"

case "$log_level" in
debug | info | warn | error) ;;
*)
	echo "log-level must be one of debug, info, warn, error" >&2
	exit 1
	;;
esac

case "$cluster_address" in
*:*) ;;
*)
	echo "cluster.address must be host:port" >&2
	exit 1
	;;
esac

tmp="$CONFIG.new"
{
	echo "key_path: \"$SNAP_COMMON/key.pem\""
	echo "cert_path: \"$SNAP_COMMON/cert.pem\""
	echo "db_path: \"$SNAP_COMMON/database\""
	echo "port: $port"
	if [ -n "$external_hostname" ]; then
		echo "external_hostname: \"$external_hostname\""
	fi
	echo "pebble_notifications: false"
	echo "cluster:"
	echo "  address: \"$cluster_address\""
	if [ -n "$cluster_name" ]; then
		echo "  name: \"$cluster_name\""
	fi
	if [ -n "$join_token" ]; then
		echo "  join_token: \"$join_token\""
	fi
	echo "logging:"
	echo "  system:"
	echo "    level: \"$log_level\""
	echo "    output: \"stdout\""
	echo "encryption_backend:"
	echo "  type: \"$encryption_backend\""
} >"$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$CONFIG"

# The join token is only read on first start; drop it so it does not sit in the
# snap configuration once it has been spent.
if [ -n "$join_token" ]; then
	snapctl unset cluster.join-token 2>/dev/null || true
fi

# Only bounce a daemon that is actually running; "inactive" must not match.
if snapctl services notary.notaryd 2>/dev/null | awk 'NR>1 && $3=="active" {found=1} END {exit !found}'; then
	snapctl restart notary.notaryd
fi
